+def _inventory_trace_event(run_id, events, phase, outcome, *, city_id=None, count=None, conn=None):
+    """Bounded identity-free durable trace / 有界脱敏持久轨迹。"""
+    import json
+    if phase not in {'inventory', 'state', 'city', 'places', 'website', 'postprocess', 'linked', 'completion'}:
+        raise ValueError('invalid_inventory_trace_phase')
+    if outcome not in {'enter', 'complete', 'failed'}:
+        raise ValueError('invalid_inventory_trace_outcome')
+    if conn is not None and conn.in_transaction:
+        raise RuntimeError('inventory_trace_inside_transaction')
+    if len(events) >= 20:
+        raise ValueError('inventory_trace_event_limit')
+    event = {'seq': len(events) + 1, 'phase': phase, 'outcome': outcome,
+             'at': datetime.now(timezone.utc).isoformat()}
+    for key, value in (('city_id', city_id), ('count', count)):
+        if value is not None:
+            if type(value) is not int or not 0 <= value <= 9223372036854775807:
+                raise ValueError('invalid_inventory_trace_integer')
+            event[key] = value
+    candidate = events + [event]
+    for index, item in enumerate(candidate, 1):
+        if (set(item) - {'seq', 'phase', 'outcome', 'at', 'city_id', 'count'}
+                or item.get('seq') != index or type(item.get('seq')) is not int
+                or item.get('phase') not in {'inventory', 'state', 'city', 'places', 'website', 'postprocess', 'linked', 'completion'}
+                or item.get('outcome') not in {'enter', 'complete', 'failed'}):
+            raise ValueError('invalid_inventory_trace_history')
+        stamp = datetime.fromisoformat(item['at'])
+        if stamp.utcoffset() != timedelta(0):
+            raise ValueError('invalid_inventory_trace_time')
+        for field in ('city_id', 'count'):
+            if field in item and (type(item[field]) is not int or not 0 <= item[field] <= 9223372036854775807):
+                raise ValueError('invalid_inventory_trace_history_integer')
+    encoded = json.dumps({'schema': 'rokt.inventory_stage_trace.v1', 'events': candidate},
+                         ensure_ascii=True, separators=(',', ':'))
+    if len(encoded.encode('utf-8')) > 16384:
+        raise ValueError('inventory_trace_byte_limit')
+    update_job_run(run_id, current_step=encoded)
+    events.append(event)
+
