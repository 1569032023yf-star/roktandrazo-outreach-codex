+def compatible_recovery_history(retry: dict, key: str) -> dict | None:
+    """Recover counts only from unchanged, complete failure events / 只按完整真实事件恢复计数。"""
+    if not isinstance(retry, dict) or not isinstance(retry.get('failures'), list):
+        return None
+    value = dict(retry)
+    value['unavailable_attempts' if key == 'linked_backlog_retry' else 'attempts'] = len(value['failures'])
+    return value if recovery_history_valid(value, key) else None
+
+
+def legacy_recovery_handoff_valid(retry: dict, key: str) -> bool:
+    """Manual classification only, never network exhaustion or SAFE / 仅人工分类。"""
+    try:
+        handoff = retry['compatibility_handoff']
+        original = handoff['legacy_retry']
+        stamp = datetime.fromisoformat(handoff['applied_at'])
+        expected_hash = hashlib.sha256(json.dumps(original, sort_keys=True, separators=(',', ':')).encode()).hexdigest()
+        return (type(handoff['schema_version']) is int and handoff['schema_version'] == 1
+                and retry.get('ledger_schema_version') == 2 and set(handoff) == {'schema_version', 'action', 'applied_at', 'legacy_sha256', 'legacy_retry'}
+                and handoff['action'] == 'manual_review'
+                and stamp.tzinfo is not None and stamp.utcoffset() == timedelta(0) and stamp <= datetime.now(timezone.utc)
+                and (not isinstance(original, dict) or all(retry.get(k) == v for k, v in original.items() if k not in {'ledger_schema_version', 'compatibility_handoff', 'automation_terminal_outcome', 'automation_terminal_at'}))
+                and handoff['legacy_sha256'] == expected_hash
+                and compatible_recovery_history(original, key) is None
+                and bool(original) and retry['automation_terminal_outcome'] == 'legacy_metadata_manual_review'
+                and retry['automation_terminal_at'] == handoff['applied_at'])
+    except (KeyError, TypeError, ValueError, AttributeError, OverflowError):
+        return False
+
