    {
      "id": "owned_file_authority",
      "zh": "旧凭据真实字节、独立批准哈希及磁盘字节一致；不接受调用者 owned 字典。",
      "en": "Actual previous receipt bytes, independent approved hash and on-disk bytes must agree; caller-supplied ownership maps are removed."
    },
    {
      "id": "staging_and_generated_paths",
      "zh": "逐组件拒绝 .u1-new，包与安装器拒绝自生成配置路径；拒绝大小写与祖先碰撞。",
      "en": "Reject staging components, installer-generated payload paths and case/ancestor collisions."
    },
    {
      "id": "verified_receipts_and_backup_bound",
      "zh": "receipt 仅实际 FILES_APPLIED 回读后可用；新内容与备份各限 16 MiB。",
      "en": "Receipts require verified applied bytes; payload and backups each have a 16 MiB aggregate bound."
    },
    {
      "id": "historical_rollback",
      "zh": "旧 A 在 B 升级后回滚先全量只读检查，拒绝前不修改 ACL、SCM 或历史日志。",
      "en": "Historical A rollback after B is rejected by full read-only file preflight before ACL, SCM or historical-journal changes."
    },
    {
      "id": "credential_expiry",
      "zh": "mailbox 操作返回后再次验证凭据；reserve 期间过期返回 401，保持 RESERVED 且不释放事件。",
      "en": "Authentication is repeated after mailbox operations; expiry during reserve returns 401 and preserves RESERVED without releasing event bytes."
    },
    {
      "id": "fresh_roots_absent",
      "zh": "仅按记录身份清理本事务新建空目录和 Code/State 新根；升级保留原根状态；早期未准备文件计划也由安装日志补偿。",
      "en": "Only identity-recorded empty transaction directories and fresh roots are removed; upgrades preserve old roots/state; install-journal compensation handles early exits before file preparation."
    },
    {
      "id": "cleanup_intent_exit_recovery",
      "zh": "目录、Code 与 State 删除意图和效果后共六个真实进程退出点恢复通过；ROOT_REMOVE_INTENT 下根尚存在可继续安全补偿。",
      "en": "Six actual process-exit cut points at directory/Code/State removal intent and effect recover successfully, including ROOT_REMOVE_INTENT with a still-present root."
    },
    {
      "id": "explicit_new_operation",
      "zh": "相同包回滚完成后可用新显式 OperationId 再首装；UNKNOWN 未决操作仍全局封锁。",
      "en": "A fresh explicit OperationId permits the same package after confirmed rollback; pending UNKNOWN operations remain globally fenced."
    }
