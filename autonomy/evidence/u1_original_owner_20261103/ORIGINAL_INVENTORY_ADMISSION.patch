diff --git a/bd_db.py b/bd_db.py
index c94d9b0..e726c04 100644
--- a/bd_db.py
+++ b/bd_db.py
@@ -817,0 +818,12 @@ def acquire_run_lock(date_str: str = None, holder: str = 'daily_operator', stale
+        from autonomy.inventory_maintenance import blocked as maintenance_blocked
+        if maintenance_blocked(conn):
+            conn.rollback()
+            return False
+        # The original Inventory is one authority across business dates. A
+        # timestamp cannot prove its previous side effects or process stopped.
+        # Never steal an unknown Inventory lock, including after restart.
+        if date_str.startswith('inventory:'):
+            from autonomy.inventory_maintenance import inventory_lock_blocked
+            if inventory_lock_blocked(conn):
+                conn.rollback()
+                return False
diff --git a/bd_orchestrator.py b/bd_orchestrator.py
index 1e30ede..28c2d8f 100644
--- a/bd_orchestrator.py
+++ b/bd_orchestrator.py
@@ -414,0 +415 @@ def stage_inventory(run_id: str, business_date: str, dry_run: bool):
+    inventory_outcome_known = True
@@ -482,2 +483,6 @@ def stage_inventory(run_id: str, business_date: str, dry_run: bool):
-    except Exception as exc:
-        finish_job_run(run_id, 'stopped', stop_reason=f'linked_backlog_error:{type(exc).__name__}')
+    except BaseException as exc:
+        # A failure may follow committed discovery/provider effects. Preserve
+        # the original lock until explicit reconciliation, even for SystemExit.
+        inventory_outcome_known = False
+        if isinstance(exc, Exception):
+            finish_job_run(run_id, 'stopped', stop_reason=f'linked_backlog_error:{type(exc).__name__}')
@@ -486 +491,2 @@ def stage_inventory(run_id: str, business_date: str, dry_run: bool):
-        release_run_lock(f'inventory:{business_date}', run_id)
+        if inventory_outcome_known:
+            release_run_lock(f'inventory:{business_date}', run_id)
